---
// Mitgliedschaft: Vorteile + Anmeldeformular (Vorname optional, E-Mail, Level, Einwilligung).
// Aktiv erst, wenn social.json → mitgliedschaft.action gesetzt ist (Anbieter mit Double-Opt-in, z. B. Brevo).
import social from '../data/social.json';
import ui from '../data/startseite-ui.json';
import { stufeLang } from '../lib/stufe-lang.mjs';
import SchemaIcon from './SchemaIcon.astro';
import Kanaele from './Kanaele.astro';

const locale = Astro.locals.starlightRoute.locale ?? 'de';
const t = (ui as Record<string, typeof ui.de>)[locale] ?? ui.de;
const m = t.mitglied;
const cfg = social.mitgliedschaft;
const aktiv = Boolean(cfg.action);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const datenschutz = `${base}/${locale}/rechtliches/datenschutz/`;
const nutzung = `${base}/${locale}/rechtliches/nutzungsbedingungen/`;

// Der Einwilligungssatz trägt zwei Platzhalter, damit jede Sprache die Links
// dort setzen kann, wo ihre Wortstellung sie braucht.
const teile = m.einwilligung.split(/(\{nutzung\}|\{datenschutz\})/);
const icons = ['play', 'bolt', 'funke'] as const;
---

<div class="mitglied">
  <ul class="vorteile">
    {m.vorteile.map((v, i) => (
      <li class="vorteil">
        <span class="vorteil-icon"><SchemaIcon name={icons[i] ?? 'bolt'} /></span>
        <span class="vorteil-titel">{v.titel}</span>
        <span class="vorteil-text">{v.text}</span>
      </li>
    ))}
  </ul>

  {aktiv ? (
    <form class="formular" action={cfg.action!} method="post" data-mitglied-form data-anbieter={cfg.anbieter}>
      {Object.entries(cfg.hidden ?? {}).map(([k, v]) => <input type="hidden" name={k} value={String(v)} />)}
      <input type="hidden" name="sprache" value={locale} />
      <p class="falle" aria-hidden="true"><label>{m.email}<input type="text" name="firmenname" tabindex="-1" autocomplete="off" /></label></p>
      <div class="reihe">
        <label class="feld">
          <span>{m.email} *</span>
          <input type="email" name={cfg.felder.email} required autocomplete="email" />
        </label>
        <label class="feld">
          <span>{m.level}</span>
          <select name={cfg.felder.level}>
            {(['einstieg', 'azubi', 'profi'] as const).map((s) => <option value={s} lang={stufeLang(locale, s)}>{(t.stufen as Record<string, string>)[s]}</option>)}
          </select>
        </label>
      </div>
      <label class="einwilligung">
        <input type="checkbox" name="EINWILLIGUNG" required value="ja" />
        <span>{teile.map((s) =>
          s === '{nutzung}' ? <a href={nutzung}>{m.nutzungLink}</a>
          : s === '{datenschutz}' ? <a href={datenschutz}>{m.datenschutzLink}</a>
          : s
        )}</span>
      </label>
      <div class="aktion">
        <button type="submit" class="ww-btn ww-btn-fill">{m.senden} <span aria-hidden="true">→</span></button>
        <span class="doi">{m.doi}</span>
      </div>
      <p class="status" data-mitglied-status role="status" aria-live="polite" hidden></p>
    </form>
  ) : (
    <div class="bald">
      <p>{m.bald}</p>
    </div>
  )}
  <Kanaele bald />
</div>

<style>
  .mitglied { display: grid; gap: 1.5rem; }
  .vorteile { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); }
  .vorteil { display: flex; flex-direction: column; gap: 0.375rem; padding: 1.125rem; border: 1px solid var(--ww-line); border-radius: var(--ww-radius); background: var(--ww-surface); }
  .vorteil-icon { width: 2.25rem; height: 2.25rem; display: inline-flex; align-items: center; justify-content: center; border-radius: var(--ww-radius-sm); background: var(--ww-accent-soft); color: var(--ww-accent); margin-bottom: 0.25rem; }
  .vorteil-icon :global(svg) { width: 1.25rem; height: 1.25rem; }
  .vorteil-titel { font-weight: 600; font-size: 1.0625rem; color: var(--ww-text); }
  .vorteil-text { font-size: var(--sl-text-sm); color: var(--ww-muted); line-height: 1.5; }
  .formular { display: grid; gap: 1rem; padding: 1.25rem; border: 1px solid var(--ww-line); border-radius: var(--ww-radius); background: var(--ww-surface); }
  .reihe { display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); }
  .feld { display: grid; gap: 0.3rem; font-size: var(--sl-text-sm); color: var(--ww-muted); }
  .feld input, .feld select { padding: 0.625rem 0.75rem; border-radius: var(--ww-radius-sm); border: 1px solid var(--ww-line); background: var(--ww-bg); color: var(--ww-text); font: inherit; }
  .feld input:focus, .feld select:focus { outline: 2px solid var(--ww-accent); outline-offset: 2px; }
  .einwilligung { display: flex; gap: 0.6rem; align-items: flex-start; font-size: var(--sl-text-xs); color: var(--ww-muted); line-height: 1.5; }
  .einwilligung input { margin-top: 0.2rem; accent-color: var(--ww-accent); }
  .einwilligung a { color: var(--ww-accent); }
  .aktion { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; }
  .doi { font-size: var(--sl-text-xs); color: var(--ww-muted); max-width: 36ch; }
  .falle { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .status { margin: 0; font-size: var(--sl-text-sm); line-height: 1.5; }
  .status[data-art='ok'] { color: var(--ww-accent); }
  .status[data-art='fehler'] { color: var(--ww-warn, #ff7b7b); }
  .bald { display: grid; gap: 0.75rem; padding: 1.125rem; border: 1px dashed var(--ww-line); border-radius: var(--ww-radius); }
  .bald p { margin: 0; color: var(--ww-muted); line-height: 1.5; }
</style>

<script is:inline define:vars={{ texte: { laeuft: m.laeuft, ok: m.erfolg, doppelt: m.doppelt, fehler: m.fehler } }}>
  // Ohne JS sendet das Formular normal und die Function antwortet mit einer kleinen HTML-Seite.
  for (const form of document.querySelectorAll('form[data-mitglied-form]')) {
    const status = form.querySelector('[data-mitglied-status]');
    const knopf = form.querySelector('button[type=submit]');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.hidden = false;
      status.removeAttribute('data-art');
      status.textContent = texte.laeuft;
      knopf.disabled = true;
      try {
        const antwort = await fetch(form.action, {
          method: 'POST',
          headers: { accept: 'application/json' },
          body: new FormData(form),
        });
        const daten = await antwort.json().catch(() => ({}));
        if (antwort.ok) {
          status.dataset.art = 'ok';
          status.textContent = texte.ok;
          form.reset();
        } else {
          status.dataset.art = 'fehler';
          status.textContent = daten.grund === 'doppelt' ? texte.doppelt : texte.fehler;
        }
      } catch {
        status.dataset.art = 'fehler';
        status.textContent = texte.fehler;
      } finally {
        knopf.disabled = false;
      }
    });
  }
</script>
