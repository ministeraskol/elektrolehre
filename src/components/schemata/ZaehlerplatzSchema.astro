---
// Blockschema Hausanschluss -> Zählerplatz -> Kundenanlage nach VDE-AR-N 4100 (stark vereinfacht).
const bloecke: [number, string, string][] = [
  [40, 'Hausanschlusskasten (HAK)', 'NH-Sicherungen · Eigentum/Plombe Netzbetreiber'],
  [120, 'Hauptleitung', 'z. B. NYY-J 5×16 mm² · ungezählt'],
  [200, 'Hauptleitungsabzweigklemme / Sammelschiene', 'im Zählerschrank, unterer Anschlussraum'],
  [280, 'SLS-Schalter (selektiver Hauptleitungsschutzschalter)', 'z. B. 3×35 A, E-Charakteristik · vor dem Zähler'],
  [360, 'Zähler (eHZ oder 3-Punkt) · Zählerfeld', 'gesetzt und verplombt vom Netzbetreiber'],
  [440, 'Hauptschalter · RCD · LS im Verteilerfeld (oberer Anschlussraum)', 'Beginn der Kundenanlage · Stromkreise'],
];
---

<figure class="schema-wrap" dir="ltr">
  <svg class="schema" viewBox="0 0 800 560" role="img" aria-labelledby="zp-title" xmlns="http://www.w3.org/2000/svg">
    <title id="zp-title">Blockschema Zählerplatz: Hausanschlusskasten, Hauptleitung, Sammelschiene, SLS-Schalter, Zähler, Verteilerfeld</title>
    <g fill="none" stroke="currentColor" stroke-width="2">
      {bloecke.map(([y]) => <rect x="120" y={y} width="560" height="56" rx="6" />)}
      {bloecke.slice(0, -1).map(([y]) => <line x1="400" y1={y + 56} x2="400" y2={y + 80} />)}
      <!-- Grenze Netzbetreiber / Kunde -->
      <line x1="60" y1="424" x2="740" y2="424" stroke-dasharray="8 6" />
      <!-- Abgang zur Unterverteilung -->
      <line x1="400" y1="496" x2="400" y2="530" />
      <polygon points="392,522 408,522 400,536" fill="currentColor" stroke="none" />
    </g>
    <g fill="currentColor" font-family="system-ui, sans-serif" text-anchor="middle">
      {bloecke.map(([y, a, b]) => (
        <g>
          <text x="400" y={y + 24} font-size="13" font-weight="600">{a}</text>
          <text x="400" y={y + 42} font-size="11">{b}</text>
        </g>
      ))}
      <text x="80" y="416" font-size="10" text-anchor="start">Netzbetreiber-Plombierung bis hier</text>
      <text x="720" y="440" font-size="10" text-anchor="end">Kundenanlage (§ 13 NAV: Arbeit nur durch eingetragenen Betrieb)</text>
      <text x="400" y="552" font-size="11">Zuleitung zur Unterverteilung der Wohnung</text>
    </g>
  </svg>
  <figcaption>Blockschema stark vereinfacht. Aufbau, Räume (APZ, RfZ, Datenraum) und Bemessung immer nach VDE-AR-N 4100 und den TAB des Netzbetreibers.</figcaption>
</figure>

<style>
  .schema-wrap { margin: 1.5rem 0; }
  .schema { width: 100%; height: auto; color: var(--sl-color-white); }
  figcaption { font-size: var(--sl-text-sm); color: var(--sl-color-gray-2); margin-top: 0.5rem; }
</style>
