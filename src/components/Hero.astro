---
// Hero-Override (Starlight `components.Hero`): Schiefer-Band mit Blaupausen-Raster, Titel, Wertversprechen,
// primärer CTA aus dem Frontmatter, Sprachleiste (8 Sprachen) und animiertem Stromkreis.
import config from 'virtual:starlight/user-config';
import { LinkButton } from '@astrojs/starlight/components';
const PAGE_TITLE_ID = '_top';
import HeroSchaltkreis from './schemata/HeroSchaltkreis.astro';
import ui from '../data/startseite-ui.json';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
const locale = Astro.currentLocale ?? 'de';
const t = (ui as Record<string, typeof ui.de>)[locale] ?? ui.de;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sprachen = Object.entries(config.locales ?? {}).map(([code, l]) => ({ code, label: l!.label, href: `${base}/${code}/` }));
---

<section class="ww-hero not-content">
  <div class="ww-hero-innen">
    <div class="ww-hero-text">
      <p class="ww-kicker"><span class="ww-kicker-punkt" aria-hidden="true"></span>{t.kicker}</p>
      <h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
      {tagline && <p class="ww-tagline" set:html={tagline} />}
      {actions.length > 0 && (
        <div class="ww-actions">
          {actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
            <LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
              {text}
              {icon?.html && <Fragment set:html={icon.html} />}
            </LinkButton>
          ))}
          <a class="ww-sekundaer" href="./grundlagen/strom-spannung-widerstand/">{t.grundlagenLink}</a>
        </div>
      )}
      <nav class="ww-sprachen" aria-label={t.sprachenLabel}>
        <span class="ww-sprachen-titel">{t.sprachenTitel}</span>
        <ul>
          {sprachen.map((s) => (
            <li><a href={s.href} lang={s.code} hreflang={s.code} aria-current={s.code === locale ? 'page' : undefined}>{s.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
    <div class="ww-hero-bild">
      <HeroSchaltkreis />
    </div>
  </div>
</section>

<style>
  .ww-hero {
    /* Über die Inhaltsbreite hinaus auf die volle Fensterbreite ziehen */
    margin-inline: calc(50% - 50vw);
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(2.5rem, 6vw, 4.5rem);
    background-color: var(--ww-hero-bg);
    background-image:
      linear-gradient(rgba(148, 163, 184, 0.12) 1px, transparent 1px),
      linear-gradient(90deg, rgba(148, 163, 184, 0.12) 1px, transparent 1px);
    background-size: 1.5rem 1.5rem;
    color: #ffffff;
    border-bottom: 1px solid var(--ww-slate-700);
    position: relative;
  }
  .ww-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(60% 80% at 80% 50%, rgba(245, 158, 11, 0.12), transparent 70%);
    pointer-events: none;
  }
  .ww-hero-innen {
    position: relative;
    z-index: 1;
    max-width: 68.75rem;
    margin-inline: auto;
    padding-inline: var(--sl-content-pad-x);
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  .ww-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1rem;
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ww-amber-300);
  }
  .ww-kicker-punkt { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--ww-amber-500); box-shadow: 0 0 0 4px rgba(245, 158, 11, 0.25); }
  h1 {
    font-family: var(--ww-font-heading);
    font-size: clamp(2.25rem, 1rem + 5vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
    max-width: 16ch;
  }
  .ww-tagline {
    margin: 1.25rem 0 0;
    font-size: clamp(1.05rem, 0.9rem + 0.8vw, 1.3rem);
    line-height: 1.6;
    color: var(--ww-slate-300);
    max-width: 52ch;
  }
  .ww-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; margin-top: 1.75rem; }
  .ww-sekundaer { color: #ffffff; font-weight: 600; text-decoration: none; border-bottom: 1.5px solid var(--ww-slate-500); padding-bottom: 0.15rem; }
  .ww-sekundaer:hover { border-color: var(--ww-amber-500); }
  .ww-sprachen { margin-top: 2rem; }
  .ww-sprachen-titel {
    display: block;
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-2xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ww-slate-400);
    margin-bottom: 0.5rem;
  }
  .ww-sprachen ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .ww-sprachen a {
    display: inline-block;
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--ww-slate-600);
    border-radius: 999px;
    color: var(--ww-slate-200);
    font-size: var(--sl-text-sm);
    text-decoration: none;
    transition: border-color 0.15s ease, background 0.15s ease, transform 0.15s ease;
  }
  .ww-sprachen a:hover { border-color: var(--ww-amber-500); background: rgba(245, 158, 11, 0.1); transform: translateY(-1px); }
  .ww-sprachen a[aria-current='page'] { background: var(--ww-amber-500); border-color: var(--ww-amber-500); color: var(--ww-slate-900); font-weight: 600; }
  .ww-hero-bild {
    max-width: 28rem;
    margin-inline: auto;
    width: 100%;
    padding: 1.25rem;
    border: 1px solid var(--ww-slate-700);
    border-radius: var(--ww-radius);
    background: rgba(15, 23, 42, 0.55);
    box-shadow: 0 24px 48px -24px rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(2px);
  }
  @media (min-width: 50rem) {
    .ww-hero-innen { grid-template-columns: 7fr 5fr; gap: 3rem; }
    .ww-hero-bild { max-width: none; }
  }
</style>
