---
// Hero-Override: oversized Headline aus dem Frontmatter, Funken/Strom-Animation, animierter Schaltkreis,
// primärer CTA + Social-Buttons (Kanäle starten jetzt) + Sprachleiste.
import config from 'virtual:starlight/user-config';
import { LinkButton } from '@astrojs/starlight/components';
import HeroSchaltkreis from './schemata/HeroSchaltkreis.astro';
import Kanaele from './Kanaele.astro';
import SchemaIcon from './SchemaIcon.astro';
import ui from '../data/startseite-ui.json';
const PAGE_TITLE_ID = '_top';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
const locale = Astro.currentLocale ?? 'de';
const t = (ui as Record<string, typeof ui.de>)[locale] ?? ui.de;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sprachen = Object.entries(config.locales ?? {}).map(([code, l]) => ({ code, label: l!.label, href: `${base}/${code}/` }));
// Headline: letzter Satzteil bekommt den Verlauf („Einfach erklärt.“)
const teile = String(title).split(/(?<=\.)\s+/);
const kopf = teile.length > 1 ? teile.slice(0, -1).join(' ') : '';
const akzent = teile[teile.length - 1];
---

<section class="ww-hero not-content">
  <div class="ww-funken" aria-hidden="true">
    {Array.from({ length: 14 }).map((_, i) => <span class="funke" style={`--i:${i}; --x:${(i * 37) % 100}%; --y:${(i * 53) % 100}%; --s:${0.6 + (i % 4) * 0.25}`}></span>)}
  </div>
  <div class="ww-hero-innen">
    <div class="ww-hero-text">
      <p class="ww-kicker"><SchemaIcon name="bolt" class="ww-kicker-icon" />{t.kicker}</p>
      <h1 id={PAGE_TITLE_ID} data-page-title>
        {kopf && <span class="h1-kopf">{kopf}</span>}
        <span class="h1-akzent">{akzent}</span>
      </h1>
      {tagline && <p class="ww-tagline" set:html={tagline} />}
      <div class="ww-actions">
        {actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
          <LinkButton {href} {variant} icon={icon?.name} class:list={[className, 'magnet']} {...attrs}>
            {text}
            {icon?.html && <Fragment set:html={icon.html} />}
          </LinkButton>
        ))}
      </div>
      <div class="ww-social">
        <span class="ww-social-titel">{t.ctaSocialTitel}</span>
        <Kanaele />
      </div>
      <nav class="ww-sprachen" aria-label={t.sprachenLabel}>
        <span class="ww-sprachen-titel">{t.sprachenTitel}</span>
        <ul>
          {sprachen.map((s) => (
            <li><a href={s.href} lang={s.code === 'leicht' ? 'de' : s.code} hreflang={s.code === 'leicht' ? 'de-x-leicht' : s.code} aria-current={s.code === locale ? 'page' : undefined}>{s.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
    <div class="ww-hero-bild reveal ist-sichtbar">
      <HeroSchaltkreis />
      <p class="ww-bild-label"><SchemaIcon name="funke" class="ww-bild-icon" /> {t.heroBildLabel}</p>
    </div>
  </div>
</section>

<style>
  .ww-hero {
    margin-inline: calc(50% - 50vw);
    padding-block: clamp(3rem, 7vw, 6rem) clamp(2.5rem, 6vw, 4.5rem);
    background-color: #0f172a;
    background-image: linear-gradient(rgba(148, 163, 184, 0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(148, 163, 184, 0.1) 1px, transparent 1px);
    background-size: 1.5rem 1.5rem;
    color: #fff;
    border-bottom: 1px solid #334155;
    position: relative;
    overflow: hidden;
  }
  .ww-hero::after { content: ''; position: absolute; inset: 0; background: radial-gradient(55% 70% at 85% 45%, color-mix(in srgb, var(--ww-orange) 22%, transparent), transparent 70%), radial-gradient(35% 45% at 10% 90%, color-mix(in srgb, var(--ww-cyan) 14%, transparent), transparent 70%); pointer-events: none; }
  .ww-funken { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  .funke { position: absolute; left: var(--x); top: var(--y); width: 4px; height: 4px; border-radius: 50%; background: var(--ww-amber); box-shadow: 0 0 10px 2px var(--ww-amber); opacity: 0; transform: scale(var(--s)); animation: ww-funke 5s calc(var(--i) * -0.37s) ease-in-out infinite; }
  .funke:nth-child(3n) { background: var(--ww-cyan); box-shadow: 0 0 10px 2px var(--ww-cyan); }
  @keyframes ww-funke { 0%, 100% { opacity: 0; transform: translateY(0) scale(var(--s)); } 20% { opacity: 0.9; } 50% { opacity: 0.4; transform: translateY(-40px) scale(calc(var(--s) * 1.3)); } 80% { opacity: 0; transform: translateY(-80px) scale(var(--s)); } }
  @media (prefers-reduced-motion: reduce) { .funke { animation: none; opacity: 0.4; } }
  .ww-hero-innen { position: relative; z-index: 1; max-width: 68.75rem; margin-inline: auto; padding-inline: var(--sl-content-pad-x); display: grid; gap: 2.5rem; align-items: center; }
  .ww-kicker { display: inline-flex; align-items: center; gap: 0.5rem; margin: 0 0 1.25rem; padding: 0.35rem 0.9rem 0.35rem 0.6rem; border-radius: 999px; border: 1px solid color-mix(in srgb, var(--ww-amber) 45%, transparent); background: color-mix(in srgb, var(--ww-amber) 10%, transparent); font-family: var(--__sl-font-mono); font-size: var(--sl-text-xs); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ww-amber-hell); }
  .ww-kicker-icon { width: 1rem; height: 1rem; color: var(--ww-amber); }
  h1 { font-family: var(--ww-font-heading); font-size: clamp(2.8rem, 1.2rem + 7.5vw, 6.25rem); line-height: 0.98; letter-spacing: -0.045em; font-weight: 700; color: #fff; margin: 0; display: flex; flex-direction: column; text-wrap: balance; }
  .h1-akzent { background: var(--ww-grad); -webkit-background-clip: text; background-clip: text; color: transparent; padding-bottom: 0.08em; }
  .ww-tagline { margin: 1.5rem 0 0; font-size: clamp(1.1rem, 0.95rem + 0.8vw, 1.35rem); line-height: 1.55; color: #cbd5e1; max-width: 46ch; }
  .ww-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; margin-top: 1.75rem; }
  .ww-actions :global(.sl-link-button) { transform: translate(var(--mx, 0), var(--my, 0)); }
  .ww-social { margin-top: 1.5rem; display: flex; flex-direction: column; gap: 0.5rem; }
  .ww-social-titel, .ww-sprachen-titel { font-family: var(--__sl-font-mono); font-size: var(--sl-text-2xs); letter-spacing: 0.1em; text-transform: uppercase; color: #94a3b8; }
  .ww-sprachen { margin-top: 1.75rem; }
  .ww-sprachen-titel { display: block; margin-bottom: 0.5rem; }
  .ww-sprachen ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .ww-sprachen a { display: inline-block; padding: 0.3rem 0.75rem; border: 1px solid #475569; border-radius: 999px; color: #e2e8f0; font-size: var(--sl-text-sm); text-decoration: none; transition: border-color 0.15s ease, background 0.15s ease, transform 0.15s ease; }
  .ww-sprachen a:hover { border-color: var(--ww-amber); background: color-mix(in srgb, var(--ww-amber) 12%, transparent); transform: translateY(-1px); }
  .ww-sprachen a[aria-current='page'] { background: var(--ww-grad); border-color: transparent; color: #0f172a; font-weight: 700; }
  .ww-hero-bild { max-width: 30rem; margin-inline: auto; width: 100%; padding: 1.25rem; border: 1px solid #334155; border-radius: var(--ww-radius); background: rgba(15, 23, 42, 0.6); box-shadow: 0 0 0 1px color-mix(in srgb, var(--ww-amber) 15%, transparent), 0 40px 80px -40px var(--ww-orange); backdrop-filter: blur(2px); }
  .ww-bild-label { margin: 0.75rem 0 0; display: flex; align-items: center; gap: 0.4rem; font-family: var(--__sl-font-mono); font-size: var(--sl-text-2xs); letter-spacing: 0.08em; text-transform: uppercase; color: #94a3b8; }
  .ww-bild-icon { width: 0.9rem; height: 0.9rem; color: var(--ww-cyan); }
  @media (min-width: 50rem) {
    .ww-hero-innen { grid-template-columns: 7fr 5fr; gap: 3rem; }
    .ww-hero-bild { max-width: none; }
  }
</style>
