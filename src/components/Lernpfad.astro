---
// Grundlagen als gamifizierte Zeitleiste: Kapitel-Nummer, Level, Lesezeit, Lernfeld-Tags, Lesefortschritt (localStorage).
// Wird auf der Startseite (basis './grundlagen/') und auf /grundlagen/ (basis './') benutzt.
import { getCollection } from 'astro:content';
import SchemaIcon from './SchemaIcon.astro';
import ui from '../data/startseite-ui.json';

interface Props { basis?: string }
const { basis = './grundlagen/' } = Astro.props;
const locale = Astro.locals.starlightRoute.locale ?? 'de';
const t = (ui as Record<string, typeof ui.de>)[locale] ?? ui.de;

const alle = await getCollection('docs');
const seite = (slug: string) => alle.find((e) => e.id === `${locale}/${slug}`) ?? alle.find((e) => e.id === `de/${slug}`);
const woerter = (body: string) => body.replace(/^import .*$/gm, '').replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length;
const kapitel = alle
  .filter((e) => /^de\/grundlagen\/(?!index$)[^/]+$/.test(e.id))
  .sort((a, b) => (a.data.sidebar?.order ?? 99) - (b.data.sidebar?.order ?? 99))
  .map((de) => {
    const slug = de.id.slice(3);
    const e = seite(slug) ?? de;
    return { slug, href: `${basis}${slug.replace('grundlagen/', '')}/`, titel: e.data.title, beschreibung: e.data.description ?? '', lernfeld: de.data.lernfeld ?? [], minuten: Math.max(3, Math.round(woerter(e.body ?? '') / 180)) };
  });
const icons = ['quelle', 'widerstand', 'rcd', 'erde'] as const;
---

<ww-lernpfad class="lernpfad not-content">
  <div class="fortschritt" role="status">
    <div class="fortschritt-leiste" aria-hidden="true"><span class="fortschritt-wert" style="--p:0"></span></div>
    <span class="fortschritt-text"><b class="fortschritt-zahl">0</b>/{kapitel.length} {t.gelesen}</span>
  </div>
  <ol class="kapitel-liste">
    {kapitel.map((k, i) => (
      <li class="kapitel" data-slug={k.slug}>
        <a class="kapitel-karte" href={k.href}>
          <span class="kapitel-nr" aria-hidden="true">
            <span class="kapitel-punkt"><SchemaIcon name="haken" class="kapitel-haken" /></span>
            <span class="kapitel-zahl">{String(i + 1).padStart(2, '0')}</span>
          </span>
          <span class="kapitel-inhalt">
            <span class="kapitel-label">{t.kapitel} {i + 1} · {k.minuten} {t.lesezeit}</span>
            <span class="kapitel-titel">{k.titel}</span>
            <span class="kapitel-text">{k.beschreibung}</span>
            <span class="tags">
              {k.lernfeld.map((lf) => <span class="tag">{t.lernfeld} {lf}</span>)}
              <span class="tag tag-quiz">{t.quiz}</span>
            </span>
          </span>
          <span class="kapitel-icon"><SchemaIcon name={icons[i] ?? 'widerstand'} /></span>
        </a>
      </li>
    ))}
  </ol>
</ww-lernpfad>

<script>
  class WwLernpfad extends HTMLElement {
    connectedCallback() {
      let gelesen: string[] = [];
      try { gelesen = JSON.parse(localStorage.getItem('wattwas.gelesen') ?? '[]'); } catch { gelesen = []; }
      const kapitel = Array.from(this.querySelectorAll<HTMLElement>('.kapitel'));
      let n = 0;
      kapitel.forEach((k) => { if (gelesen.includes(k.dataset.slug ?? '')) { k.classList.add('ist-gelesen'); n++; } });
      const zahl = this.querySelector('.fortschritt-zahl');
      const wert = this.querySelector<HTMLElement>('.fortschritt-wert');
      if (zahl) zahl.textContent = String(n);
      if (wert) wert.style.setProperty('--p', String(kapitel.length ? n / kapitel.length : 0));
    }
  }
  if (!customElements.get('ww-lernpfad')) customElements.define('ww-lernpfad', WwLernpfad);
</script>

<style>
  .lernpfad { display: block; }
  .fortschritt { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.25rem; font-size: var(--sl-text-sm); color: var(--ww-muted); }
  .fortschritt-leiste { flex: 1; height: 0.375rem; border-radius: 999px; background: var(--ww-surface-2); overflow: hidden; }
  .fortschritt-wert { display: block; height: 100%; width: calc(var(--p) * 100%); background: var(--ww-accent); border-radius: 999px; transition: width 0.4s ease; }
  .fortschritt-text b { color: var(--ww-text); }
  .kapitel-liste { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; }
  .kapitel-karte { display: flex; gap: 1rem; align-items: center; padding: 1rem 1.125rem; border: 1px solid var(--ww-line); border-radius: var(--ww-radius); background: var(--ww-surface); color: inherit; text-decoration: none; }
  .kapitel-karte:hover, .kapitel-karte:focus-visible { border-color: var(--ww-accent); }
  .kapitel-nr { flex-shrink: 0; display: flex; flex-direction: column; align-items: center; gap: 0.25rem; }
  .kapitel-zahl { font-weight: 700; font-size: 1.125rem; color: var(--ww-muted); }
  .kapitel-punkt { display: inline-flex; align-items: center; justify-content: center; width: 1.5rem; height: 1.5rem; border-radius: 999px; border: 1px solid var(--ww-line); background: var(--ww-bg); color: var(--ww-on-accent); }
  .kapitel-haken { width: 0.875rem; height: 0.875rem; opacity: 0; }
  .ist-gelesen .kapitel-punkt { background: var(--ww-accent); border-color: var(--ww-accent); }
  .ist-gelesen .kapitel-haken { opacity: 1; }
  .ist-gelesen .kapitel-zahl { color: var(--ww-accent); }
  .kapitel-inhalt { display: flex; flex-direction: column; gap: 0.25rem; min-width: 0; flex: 1; }
  .kapitel-label { font-size: 0.75rem; color: var(--ww-muted); }
  .kapitel-titel { font-weight: 600; font-size: 1.0625rem; color: var(--ww-text); line-height: 1.3; }
  .kapitel-text { color: var(--ww-muted); font-size: var(--sl-text-sm); line-height: 1.5; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.375rem; margin-top: 0.25rem; }
  .tag { font-size: 0.6875rem; font-weight: 600; padding: 0.125rem 0.5rem; border-radius: 999px; border: 1px solid var(--ww-line); color: var(--ww-muted); }
  .tag-quiz { border-color: var(--ww-accent); color: var(--ww-accent); }
  .kapitel-icon { color: var(--ww-muted); flex-shrink: 0; }
  @media (max-width: 40rem) { .kapitel-icon { display: none; } }
</style>
