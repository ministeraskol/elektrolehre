---
// Grundlagen als gamifizierte Zeitleiste: Kapitel-Nummer, Level, Lesezeit, Lernfeld-Tags, Lesefortschritt (localStorage).
// Wird auf der Startseite (basis './grundlagen/') und auf /grundlagen/ (basis './') benutzt.
import { getCollection } from 'astro:content';
import SchemaIcon from './SchemaIcon.astro';
import ui from '../data/startseite-ui.json';

interface Props { basis?: string }
const { basis = './grundlagen/' } = Astro.props;
const locale = Astro.currentLocale ?? 'de';
const t = (ui as Record<string, typeof ui.de>)[locale] ?? ui.de;

const alle = await getCollection('docs');
const seite = (slug: string) => alle.find((e) => e.id === `${locale}/${slug}`) ?? alle.find((e) => e.id === `de/${slug}`);
const woerter = (body: string) => body.replace(/^import .*$/gm, '').replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length;
const kapitel = alle
  .filter((e) => /^de\/grundlagen\/(?!index$)[^/]+$/.test(e.id))
  .sort((a, b) => (a.data.sidebar?.order ?? 99) - (b.data.sidebar?.order ?? 99))
  .map((de) => {
    const slug = de.id.slice(3);
    const e = seite(slug) ?? de;
    return { slug, href: `${basis}${slug.replace('grundlagen/', '')}/`, titel: e.data.title, beschreibung: e.data.description ?? '', lernfeld: de.data.lernfeld ?? [], minuten: Math.max(3, Math.round(woerter(e.body ?? '') / 180)) };
  });
const icons = ['quelle', 'widerstand', 'rcd', 'erde'] as const;
---

<ww-lernpfad class="lernpfad not-content">
  <div class="fortschritt" role="status">
    <span class="level"><SchemaIcon name="bolt" class="level-icon" /> <b class="level-nr">1</b></span>
    <div class="fortschritt-leiste" aria-hidden="true"><span class="fortschritt-wert" style="--p:0"></span></div>
    <span class="fortschritt-text"><b class="fortschritt-zahl">0</b>/{kapitel.length} {t.gelesen}</span>
  </div>
  <ol class="kapitel-liste">
    {kapitel.map((k, i) => (
      <li class="kapitel reveal" data-slug={k.slug} style={`--d:${i * 80}ms`}>
        <a class="kapitel-karte magnet-soft" href={k.href}>
          <span class="kapitel-nr" aria-hidden="true">
            <span class="kapitel-punkt"><SchemaIcon name="haken" class="kapitel-haken" /></span>
            <span class="kapitel-zahl">{String(i + 1).padStart(2, '0')}</span>
          </span>
          <span class="kapitel-inhalt">
            <span class="kapitel-label">{t.kapitel} {i + 1} · {k.minuten} {t.lesezeit}</span>
            <span class="kapitel-titel">{k.titel}</span>
            <span class="kapitel-text">{k.beschreibung}</span>
            <span class="tags">
              {k.lernfeld.map((lf) => <span class="tag">{t.lernfeld} {lf}</span>)}
              <span class="tag tag-quiz">{t.quiz}</span>
            </span>
          </span>
          <span class="kapitel-icon"><SchemaIcon name={icons[i] ?? 'widerstand'} /></span>
        </a>
      </li>
    ))}
  </ol>
</ww-lernpfad>

<script>
  class WwLernpfad extends HTMLElement {
    connectedCallback() {
      let gelesen: string[] = [];
      try { gelesen = JSON.parse(localStorage.getItem('wattwas.gelesen') ?? '[]'); } catch { gelesen = []; }
      const kapitel = Array.from(this.querySelectorAll<HTMLElement>('.kapitel'));
      let n = 0;
      kapitel.forEach((k) => { if (gelesen.includes(k.dataset.slug ?? '')) { k.classList.add('ist-gelesen'); n++; } });
      const zahl = this.querySelector('.fortschritt-zahl');
      const level = this.querySelector('.level-nr');
      const wert = this.querySelector<HTMLElement>('.fortschritt-wert');
      if (zahl) zahl.textContent = String(n);
      if (level) level.textContent = String(1 + n);
      if (wert) wert.style.setProperty('--p', String(kapitel.length ? n / kapitel.length : 0));
    }
  }
  if (!customElements.get('ww-lernpfad')) customElements.define('ww-lernpfad', WwLernpfad);
</script>

<style>
  .lernpfad { display: block; }
  .fortschritt { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.25rem; font-size: var(--sl-text-sm); color: var(--sl-color-gray-3); }
  .level { display: inline-flex; align-items: center; gap: 0.3rem; padding: 0.25rem 0.7rem; border-radius: 999px; background: var(--ww-grad); color: #0f172a; font-family: var(--ww-font-heading); font-weight: 700; }
  .level::before { content: 'LVL'; font-size: var(--sl-text-2xs); letter-spacing: 0.08em; }
  .level-icon { width: 1rem; height: 1rem; }
  .fortschritt-leiste { flex: 1; height: 0.6rem; border-radius: 999px; background: var(--ww-surface); overflow: hidden; border: 1px solid var(--ww-line); }
  .fortschritt-wert { display: block; height: 100%; width: calc(var(--p) * 100%); background: var(--ww-grad); border-radius: 999px; transition: width 0.8s cubic-bezier(0.2, 0.7, 0.2, 1); box-shadow: 0 0 12px var(--ww-amber); }
  .fortschritt-text b { color: var(--sl-color-white); font-family: var(--ww-font-heading); }
  .kapitel-liste { list-style: none; margin: 0; padding: 0; display: grid; position: relative; }
  .kapitel-liste::before { content: ''; position: absolute; inset-block: 2rem; inset-inline-start: 1.85rem; width: 2px; background: repeating-linear-gradient(to bottom, var(--ww-line) 0 6px, transparent 6px 12px); }
  .kapitel { padding-block: 0.4rem; }
  .kapitel-karte {
    display: flex; gap: 1.25rem; align-items: center; padding: 1.1rem 1.4rem;
    border: 1px solid var(--ww-line); border-radius: var(--ww-radius); background: var(--ww-surface);
    color: inherit; text-decoration: none; position: relative;
    transition: transform 0.2s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .kapitel-karte:hover, .kapitel-karte:focus-visible { transform: translateX(4px); border-color: var(--ww-amber); box-shadow: 0 0 0 3px color-mix(in srgb, var(--ww-amber) 20%, transparent), 0 20px 40px -24px var(--ww-amber); }
  [dir='rtl'] .kapitel-karte:hover { transform: translateX(-4px); }
  .kapitel-nr { position: relative; z-index: 1; flex-shrink: 0; display: flex; flex-direction: column; align-items: center; gap: 0.3rem; }
  .kapitel-zahl { font-family: var(--ww-font-heading); font-weight: 700; font-size: 1.4rem; letter-spacing: -0.03em; color: var(--sl-color-gray-3); }
  .kapitel-punkt { display: inline-flex; align-items: center; justify-content: center; width: 1.6rem; height: 1.6rem; border-radius: 50%; border: 2px solid var(--ww-amber); background: var(--ww-surface); color: #0f172a; box-shadow: 0 0 0 4px var(--ww-surface); }
  .kapitel-haken { width: 1rem; height: 1rem; opacity: 0; transform: scale(0.5); transition: opacity 0.2s ease, transform 0.2s ease; }
  .ist-gelesen .kapitel-punkt { background: var(--ww-grad); border-color: transparent; box-shadow: 0 0 0 4px var(--ww-surface), 0 0 16px var(--ww-amber); }
  .ist-gelesen .kapitel-haken { opacity: 1; transform: none; }
  .ist-gelesen .kapitel-zahl { color: var(--ww-amber); }
  .kapitel-inhalt { display: flex; flex-direction: column; gap: 0.3rem; min-width: 0; flex: 1; }
  .kapitel-label { font-family: var(--__sl-font-mono); font-size: var(--sl-text-2xs); letter-spacing: 0.06em; text-transform: uppercase; color: var(--sl-color-gray-3); }
  .kapitel-titel { font-family: var(--ww-font-heading); font-weight: 700; font-size: 1.2rem; letter-spacing: -0.02em; color: var(--sl-color-white); line-height: 1.2; }
  .kapitel-text { color: var(--sl-color-gray-2); font-size: var(--sl-text-sm); line-height: 1.55; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.3rem; }
  .tag { font-family: var(--__sl-font-mono); font-size: var(--sl-text-2xs); padding: 0.15rem 0.5rem; border-radius: 999px; border: 1px solid var(--ww-line); color: var(--sl-color-gray-3); }
  .tag-quiz { border-color: var(--ww-cyan); color: var(--ww-cyan); }
  .kapitel-icon { color: var(--ww-amber); opacity: 0.7; flex-shrink: 0; }
  @media (max-width: 40rem) {
    .kapitel-liste::before { display: none; }
    .kapitel-karte { gap: 0.9rem; padding: 1rem 1.1rem; }
    .kapitel-punkt { box-shadow: none; }
    .kapitel-icon { display: none; }
  }
</style>
