---
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
import Quellen from './Quellen.astro';
import Stufe from './Stufe.astro';
import StufenHinweis from './StufenHinweis.astro';

const { entry, isFallback, locale } = Astro.locals.starlightRoute;
const data = entry.data as { translated?: string; sources?: { title: string; url: string }[]; stufe?: 'einstieg' | 'azubi' | 'profi' };
const quellen = data.sources ?? [];
// Stufen-Pill + Hinweis nur auf Inhaltsseiten: die tragen `stufe` im Frontmatter (Hubs, Rechtliches, Glossar, Über nicht).

// Fallback-Seiten (deutsche Quelle in einer anderen Locale, z. B. /leicht/ueber/): Die Quelle verlinkt absolut auf /de/…
// (auch die Fachbegriff-Links aus rehype-fachbegriff) – ohne Umschreiben fiele man aus der eigenen Sprache. Deshalb wird
// der Inhalt dort einmal als HTML gerendert und jedes <a href="/de/…"> auf /<locale>/… umgeschrieben. Starlight erzeugt jede
// deutsche Seite in jeder Locale (Übersetzung oder Fallback), das Ziel existiert also (Tests „Interne Links“, „Fallback-Links“).
// Relative, Anker- und externe Links bleiben; Header, Seitenleiste und Footer (Sprachliste) liegen außerhalb dieses Slots.
// Alle anderen Seiten rendern unverändert über <slot />.
const basis = import.meta.env.BASE_URL.replace(/\/$/, '');
const regexText = (s: string) => s.replace(/[.*+?^$()|[\]{}\\]/g, '\\$&');
const deLink = new RegExp(`(<a\\b[^>]*?\\shref=")${regexText(basis)}/de/`, 'g');
const inhalt: string | undefined = isFallback && locale ? String(await Astro.slots.render('default')).replace(deLink, `$1${basis}/${locale}/`) : undefined;
---

<Default {...Astro.props}>
  {data.stufe && <StufenHinweis stufe={data.stufe} />}
  {data.stufe && (
    <p class="seiten-meta">
      {data.stufe && <Stufe stufe={data.stufe} />}
    </p>
  )}
  {inhalt === undefined ? <slot /> : <Fragment set:html={inhalt} />}
  {quellen.length > 0 && <Quellen quellen={quellen} />}
</Default>

<style>
  .seiten-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; margin: 0 0 1rem; }
</style>

<script>
  // Lesefortschritt (Entdecken „Zuletzt gelesen“, Lernpfad): besuchte Inhaltsseiten ohne Sprachpräfix lokal merken.
  // Nur localStorage, keine Übertragung – siehe Datenschutzerklärung.
  try {
    const teile = location.pathname.split('/').filter(Boolean);
    if (teile.length >= 3 && /^[a-z]{2,6}$/.test(teile[0])) {
      const slug = teile.slice(1).join('/');
      const key = 'wattwas.gelesen';
      const alt: string[] = JSON.parse(localStorage.getItem(key) ?? '[]');
      if (!alt.includes(slug)) localStorage.setItem(key, JSON.stringify([...alt, slug]));
    }
  } catch { /* privater Modus o. ä. */ }
</script>
