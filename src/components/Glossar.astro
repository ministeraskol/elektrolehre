---
// Glossar-Tabelle aus src/data/glossar.json. Fachbegriff bleibt deutsch; Erklärung in der Seitensprache,
// Fallback Deutsch, wenn die Übersetzung fehlt. Übersetzungen liegen in src/data/glossar.<lang>.json
// als { "<de-Begriff>": "<Erklärung>" }.
import glossar from '../data/glossar.json';

type Eintrag = { de: string; kat: string; def: string };
const eintraege = glossar as Eintrag[];
const locale = Astro.currentLocale ?? 'de';

const uebersetzungen: Record<string, Record<string, string>> = {};
const dateien = import.meta.glob('../data/glossar.*.json', { eager: true }) as Record<string, { default: Record<string, string> }>;
for (const [pfad, mod] of Object.entries(dateien)) {
  const m = pfad.match(/glossar\.([a-z]{2})\.json$/);
  if (m) uebersetzungen[m[1]] = mod.default;
}
const lokal = uebersetzungen[locale] ?? {};

const katNamen: Record<string, Record<string, string>> = {
  de: { beruf: 'Beruf und Ausbildung', grundlagen: 'Grundlagen', schutz: 'Schutzorgane', anlage: 'Anlage und Bauteile', schaltung: 'Schaltungen', sicherheit: 'Sicherheit, Prüfung, Normen' },
  en: { beruf: 'Profession and training', grundlagen: 'Basics', schutz: 'Protective devices', anlage: 'Installation and components', schaltung: 'Circuits', sicherheit: 'Safety, testing, standards' },
  tr: { beruf: 'Meslek ve eğitim', grundlagen: 'Temeller', schutz: 'Koruma elemanları', anlage: 'Tesisat ve parçalar', schaltung: 'Devreler', sicherheit: 'Güvenlik, test, normlar' },
  ru: { beruf: 'Профессия и обучение', grundlagen: 'Основы', schutz: 'Защитные аппараты', anlage: 'Установка и компоненты', schaltung: 'Схемы', sicherheit: 'Безопасность, проверка, нормы' },
  ar: { beruf: 'المهنة والتدريب', grundlagen: 'الأساسيات', schutz: 'أجهزة الحماية', anlage: 'التمديدات والمكوّنات', schaltung: 'الدارات', sicherheit: 'السلامة والفحص والمعايير' },
  fa: { beruf: 'حرفه و آموزش', grundlagen: 'مبانی', schutz: 'تجهیزات حفاظتی', anlage: 'تأسیسات و قطعات', schaltung: 'مدارها', sicherheit: 'ایمنی، آزمون، استانداردها' },
  ka: { beruf: 'პროფესია და სწავლება', grundlagen: 'საფუძვლები', schutz: 'დამცავი მოწყობილობები', anlage: 'ინსტალაცია და კომპონენტები', schaltung: 'სქემები', sicherheit: 'უსაფრთხოება, შემოწმება, ნორმები' },
  sq: { beruf: 'Profesioni dhe formimi', grundlagen: 'Bazat', schutz: 'Pajisjet mbrojtëse', anlage: 'Instalimi dhe komponentët', schaltung: 'Qarqet', sicherheit: 'Siguria, testimi, normat' },
};
const kopf: Record<string, [string, string]> = {
  de: ['Fachbegriff', 'Erklärung'], en: ['German term', 'Explanation'], tr: ['Almanca terim', 'Açıklama'],
  ru: ['Немецкий термин', 'Пояснение'], ar: ['المصطلح الألماني', 'الشرح'], fa: ['اصطلاح آلمانی', 'توضیح'],
  ka: ['გერმანული ტერმინი', 'განმარტება'], sq: ['Termi gjermanisht', 'Shpjegimi'],
};
const hinweis: Record<string, string> = {
  en: 'Entries without translation are shown in German.', tr: 'Çevirisi olmayan açıklamalar Almanca gösterilir.',
  ru: 'Пояснения без перевода показаны на немецком.', ar: 'الشروح غير المترجمة تظهر بالألمانية.',
  fa: 'توضیحات ترجمه‌نشده به آلمانی نمایش داده می‌شوند.', ka: 'უთარგმნელი განმარტებები გერმანულად არის ნაჩვენები.',
  sq: 'Shpjegimet pa përkthim shfaqen në gjermanisht.',
};
const kats = ['beruf', 'grundlagen', 'schutz', 'anlage', 'schaltung', 'sicherheit'];
const kn = katNamen[locale] ?? katNamen.de;
const [kTerm, kErkl] = kopf[locale] ?? kopf.de;
const fehlend = locale !== 'de' && eintraege.some((e) => !lokal[e.de]);
---

<div class="glossar">
  {fehlend && <p class="glossar-hinweis">🌐 {hinweis[locale] ?? ''}</p>}
  {kats.map((k) => (
    <section>
      <h2 id={`kat-${k}`}>{kn[k]}</h2>
      <table>
        <thead><tr><th>{kTerm}</th><th>{kErkl}</th></tr></thead>
        <tbody>
          {eintraege.filter((e) => e.kat === k).map((e) => (
            <tr>
              <th scope="row" lang="de" translate="no">{e.de}</th>
              <td lang={lokal[e.de] ? locale : 'de'}>{lokal[e.de] ?? e.def}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  ))}
</div>

<style>
  .glossar table { width: 100%; }
  .glossar th[scope='row'] { text-align: start; white-space: nowrap; font-weight: 600; }
  .glossar-hinweis { font-size: var(--sl-text-sm); color: var(--sl-color-gray-2); }
  @media (max-width: 40rem) { .glossar th[scope='row'] { white-space: normal; } }
</style>
