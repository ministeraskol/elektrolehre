---
// Seitenleiste D1 (Spec §3.2): mobil zuerst die Top-Tabs; dann Starlight-Navigation (Badges aus routeData.ts) oder – auf Entdecken –
// die Filter-Seitenleiste (Task 9); unten der Geselle-Kasten (nicht auf Rechtliches); mobil zum Schluss Theme/Sprache.
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';
import EntdeckenFilter from './EntdeckenFilter.astro';
import WoerterbuchFilter from './WoerterbuchFilter.astro';
import MarkenFilter from './MarkenFilter.astro';
import GeselleKasten from './GeselleKasten.astro';
import TabsMobil from './TabsMobil.astro';
import { istKatalog, istRechtliches } from '../scripts/seiten';
const { sidebar, entry } = Astro.locals.starlightRoute;
const katalog = istKatalog(entry.id);
// Fix-Runde 1 (Spec §3.2: „Werkzeug (Grundausstattung, Wörterbuch, Marken & Modelle)“ = flache Liste): Starlights autogenerate
// baut aus jedem Unterordner (z. B. elektrowerkzeuge/marken/) eine eigene, aufklappbare Gruppe mit dem rohen Ordnernamen als
// Label. Verschachtelte Gruppen (nicht die Top-Level-Gruppen Grundlagen/Werkzeug/Blog/… selbst) mit genau einem Link-Eintrag
// werden hier durch diesen Link ersetzt – reine Funktion, Label/URL/Badge des Links bleiben unverändert.
type Eintraege = typeof sidebar;
const geglaettet = (eintraege: Eintraege): Eintraege =>
  eintraege.map((e) => {
    if (e.type !== 'group') return e;
    const kinder = geglaettet(e.entries);
    return kinder.length === 1 && kinder[0].type === 'link' ? kinder[0] : { ...e, entries: kinder };
  });
const sidebarFlach = sidebar.map((e) => (e.type === 'group' ? { ...e, entries: geglaettet(e.entries) } : e));
---
<TabsMobil />
{katalog === 'entdecken' ? (
  <EntdeckenFilter />
) : katalog === 'woerterbuch' ? (
  <WoerterbuchFilter />
) : katalog === 'marken' ? (
  <MarkenFilter />
) : (
  <SidebarPersister><SidebarSublist sublist={sidebarFlach} /></SidebarPersister>
)}
{!istRechtliches(entry.id) && <GeselleKasten />}
<div class="md:sl-hidden"><MobileMenuFooter /></div>
