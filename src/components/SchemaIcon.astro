---
// Schaltzeichen (nach IEC 60617 vereinfacht) als dekorative Icons. currentColor, 32×32.
interface Props { name: 'quelle' | 'widerstand' | 'schalter' | 'rcd' | 'zaehler' | 'wechsel' | 'lampe' | 'erde' | 'haken'; class?: string }
const { name, class: className } = Astro.props;
---

<svg class:list={['schema-icon', className]} viewBox="0 0 32 32" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'quelle' && (
    <>
      <line x1="2" y1="16" x2="11" y2="16" />
      <line x1="11" y1="9" x2="11" y2="23" stroke-width="2.6" />
      <line x1="16" y1="12" x2="16" y2="20" />
      <line x1="21" y1="9" x2="21" y2="23" stroke-width="2.6" />
      <line x1="26" y1="12" x2="26" y2="20" />
      <line x1="26" y1="16" x2="30" y2="16" />
    </>
  )}
  {name === 'widerstand' && (
    <>
      <line x1="2" y1="16" x2="8" y2="16" />
      <rect x="8" y="11" width="16" height="10" rx="1" />
      <line x1="24" y1="16" x2="30" y2="16" />
    </>
  )}
  {name === 'schalter' && (
    <>
      <line x1="2" y1="16" x2="10" y2="16" />
      <circle cx="11" cy="16" r="1.6" fill="currentColor" stroke="none" />
      <line x1="12" y1="15" x2="22" y2="8" />
      <circle cx="22" cy="16" r="1.6" fill="currentColor" stroke="none" />
      <line x1="23" y1="16" x2="30" y2="16" />
    </>
  )}
  {name === 'rcd' && (
    <>
      <line x1="2" y1="12" x2="8" y2="12" /><line x1="2" y1="20" x2="8" y2="20" />
      <rect x="8" y="6" width="16" height="20" rx="2" />
      <line x1="24" y1="12" x2="30" y2="12" /><line x1="24" y1="20" x2="30" y2="20" />
      <path d="M12 20 l4 -8 l4 8" />
      <circle cx="16" cy="14" r="5" stroke-dasharray="2 2" />
    </>
  )}
  {name === 'zaehler' && (
    <>
      <line x1="2" y1="16" x2="7" y2="16" />
      <circle cx="16" cy="16" r="9" />
      <text x="16" y="19" text-anchor="middle" font-size="7" font-family="ui-monospace, monospace" fill="currentColor" stroke="none">kWh</text>
      <line x1="25" y1="16" x2="30" y2="16" />
    </>
  )}
  {name === 'wechsel' && (
    <>
      <line x1="2" y1="16" x2="8" y2="16" />
      <circle cx="9" cy="16" r="1.5" fill="currentColor" stroke="none" />
      <line x1="10" y1="15" x2="17" y2="10" />
      <line x1="18" y1="10" x2="24" y2="10" /><line x1="18" y1="22" x2="24" y2="22" />
      <line x1="24" y1="10" x2="24" y2="22" />
      <line x1="24" y1="16" x2="30" y2="16" />
    </>
  )}
  {name === 'lampe' && (
    <>
      <line x1="2" y1="16" x2="8" y2="16" />
      <circle cx="16" cy="16" r="8" />
      <line x1="10.3" y1="10.3" x2="21.7" y2="21.7" /><line x1="21.7" y1="10.3" x2="10.3" y2="21.7" />
      <line x1="24" y1="16" x2="30" y2="16" />
    </>
  )}
  {name === 'erde' && (
    <>
      <line x1="16" y1="4" x2="16" y2="16" />
      <line x1="6" y1="16" x2="26" y2="16" /><line x1="10" y1="21" x2="22" y2="21" /><line x1="14" y1="26" x2="18" y2="26" />
    </>
  )}
  {name === 'haken' && <path d="M7 17 l6 6 l12 -14" stroke-width="3" />}
</svg>

<style>
  .schema-icon { display: inline-block; width: 2rem; height: 2rem; flex-shrink: 0; }
</style>
