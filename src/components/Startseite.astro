---
// Startseite unterhalb des Heros – Reihenfolge: Folge uns (Video-Karten) → Themen-Grid → Lernpfad → Anleitungen →
// Werkzeug-Teaser → Unterstütze uns → Community. Optional `saeulen` (z. B. Leichte Sprache) als erste Karten-Reihe.
// Stromlinie (links) verbindet die Abschnitte; Scroll-Reveal, Cursor-Glow und Magnet-Buttons nur bei pointer:fine.
import { getCollection } from 'astro:content';
import { Icon } from '@astrojs/starlight/components';
import SchemaIcon from './SchemaIcon.astro';
import type { IconName } from './SchemaIcon.astro';
import Lernpfad from './Lernpfad.astro';
import Kanaele from './Kanaele.astro';
import Mitglied from './Mitglied.astro';
import ui from '../data/startseite-ui.json';
import social from '../data/social.json';
import videosDaten from '../data/videos.json';
import werkzeugDaten from '../data/werkzeuge.json';

interface Saeule { titel: string; text: string; href: string }
interface Props { saeulen?: Saeule[] }
const { saeulen = [] } = Astro.props;

const locale = Astro.currentLocale ?? 'de';
const t = (ui as Record<string, typeof ui.de>)[locale] ?? ui.de;
const kanalUrl = Object.fromEntries(social.kanaele.map((k) => [k.id, k.url]));
// Videotitel und Serienname in der Seitensprache, Fallback Deutsch
const serien = videosDaten.serien as Record<string, Record<string, string>>;
const videos = videosDaten.videos.map((v) => ({
  ...v,
  titel: (v.i18n as Record<string, string> | undefined)?.[locale] ?? v.titel,
  serie: serien[v.serie]?.[locale] ?? v.serie,
}));

const alle = await getCollection('docs');
const seite = (slug: string) => alle.find((e) => e.id === `${locale}/${slug}`) ?? alle.find((e) => e.id === `de/${slug}`);
const woerter = (body: string) => body.replace(/^import .*$/gm, '').replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length;
const ANLEITUNGEN = ['unterverteilung', 'zaehlerplatz', 'wechselschaltung-steckdose'];
const anleitungen = ANLEITUNGEN.map((s, i) => {
  const slug = `themen/energie-und-gebaeudetechnik/${s}`;
  const de = alle.find((e) => e.id === `de/${slug}`)!;
  const e = seite(slug) ?? de;
  return { href: `./${slug}/`, titel: e.data.title, beschreibung: e.data.description ?? '', stufe: de.data.stufe, minuten: Math.max(3, Math.round(woerter(e.body ?? '') / 180)), icon: (['rcd', 'zaehler', 'wechsel'] as const)[i] };
});
const pflicht = werkzeugDaten.werkzeuge.filter((w) => w.badge === 'pflicht').slice(0, 3);
const saeulenIcons = ['widerstand', 'chip', 'messgeraet'] as const;
---

<div class="startseite not-content">
  <div class="stromlinie" aria-hidden="true"></div>

  {saeulen.length > 0 && (
    <section class="abschnitt reveal" aria-label={t.saeulenTitel}>
      <ul class="karten-3">
        {saeulen.map((s, i) => (
          <li class="reveal" style={`--d:${i * 90}ms`}>
            <a class="karte magnet-soft" href={s.href}>
              <span class="karte-icon farbe-amber"><SchemaIcon name={saeulenIcons[i] ?? 'widerstand'} /></span>
              <span class="karte-titel">{s.titel}</span>
              <span class="karte-text">{s.text}</span>
              <span class="karte-cta">{t.oeffnen} <span aria-hidden="true">→</span></span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="abschnitt reveal" aria-labelledby="ww-folge">
    <header class="abschnitt-kopf">
      <p class="eyebrow">{t.folgeEyebrow}</p>
      <h2 id="ww-folge">{t.folgeTitel}</h2>
      <p>{t.folgeUntertitel}</p>
      <Kanaele class="folge-kanaele" />
    </header>
    <ul class="feed">
      {videos.map((v, i) => {
        const href = v.url ?? kanalUrl[v.kanal] ?? '#';
        return (
          <li class="reveal" style={`--d:${(i % 3) * 90}ms`}>
            <a class:list={['video', `farbe-${v.farbe}`, 'magnet-soft']} href={href} target="_blank" rel="noopener">
              <span class="video-poster" aria-hidden="true">
                <SchemaIcon name={v.icon as IconName} class="video-icon" />
                <span class="video-play"><SchemaIcon name="play" /></span>
                <span class="video-dauer">{v.dauer}</span>
                <span class="video-kanal"><Icon name={v.kanal as 'youtube'} size="1.1em" /> @{social.handle}</span>
              </span>
              <span class="video-serie">{v.serie}</span>
              <span class="video-titel">{v.titel}</span>
              <span class="video-status">{v.status === 'live' ? t.live : t.bald}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </section>

  <section class="abschnitt reveal" aria-labelledby="ww-themen">
    <header class="abschnitt-kopf">
      <p class="eyebrow">{t.themenEyebrow}</p>
      <h2 id="ww-themen">{t.themenTitel}</h2>
      <p>{t.themenUntertitel}</p>
    </header>
    <ul class="themen-grid">
      {t.themen.map((th, i) => (
        <li class="reveal" style={`--d:${(i % 3) * 90}ms`}>
          {th.href ? (
            <a class:list={['thema', `farbe-${th.farbe}`, 'magnet-soft']} href={th.href}>
              <span class="thema-icon"><SchemaIcon name={th.icon as IconName} /></span>
              <span class="thema-titel">{th.titel}</span>
              <span class="thema-text">{th.text}</span>
            </a>
          ) : (
            <div class:list={['thema', 'thema-bald', `farbe-${th.farbe}`]}>
              <span class="thema-icon"><SchemaIcon name={th.icon as IconName} /></span>
              <span class="thema-titel">{th.titel}</span>
              <span class="thema-text">{th.text}</span>
              <span class="thema-tag">{t.inArbeit}</span>
            </div>
          )}
        </li>
      ))}
    </ul>
    <p class="mehr"><a href="./themen/">{t.themenAlle} <span aria-hidden="true">→</span></a></p>
  </section>

  <section class="abschnitt reveal" aria-labelledby="ww-lernpfad">
    <header class="abschnitt-kopf">
      <p class="eyebrow">{t.lernpfadEyebrow}</p>
      <h2 id="ww-lernpfad">{t.lernpfadTitel}</h2>
      <p>{t.lernpfadUntertitel}</p>
    </header>
    <Lernpfad basis="./grundlagen/" />
  </section>

  <section class="abschnitt reveal" aria-labelledby="ww-anleitungen">
    <header class="abschnitt-kopf">
      <p class="eyebrow">{t.anleitungenEyebrow}</p>
      <h2 id="ww-anleitungen">{t.anleitungenTitel}</h2>
      <p>{t.anleitungenUntertitel}</p>
    </header>
    <ul class="karten-3">
      {anleitungen.map((a, i) => (
        <li class="reveal" style={`--d:${i * 90}ms`}>
          <a class="karte anleitung magnet-soft" href={a.href}>
            <span class="anleitung-kopf">
              <span class="karte-icon farbe-cyan"><SchemaIcon name={a.icon} /></span>
              <span class:list={['badge', `badge-${a.stufe}`]}>{(t.stufen as Record<string, string>)[a.stufe]}</span>
            </span>
            <span class="karte-titel">{a.titel}</span>
            <span class="karte-text">{a.beschreibung}</span>
            <span class="anleitung-fuss">
              <span class="lesezeit">⏱ {a.minuten} {t.lesezeit}</span>
              <span class="karte-cta">{t.oeffnen} <span aria-hidden="true">→</span></span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="abschnitt reveal werkzeug-teaser" aria-labelledby="ww-werkzeug">
    <div class="teaser-text">
      <p class="eyebrow">{t.werkzeugEyebrow}</p>
      <h2 id="ww-werkzeug">{t.werkzeugTitel}</h2>
      <p>{t.werkzeugUntertitel}</p>
      <a class="btn btn-primary magnet" href="./elektrowerkzeuge/">{t.werkzeugCta} <span aria-hidden="true">→</span></a>
    </div>
    <ul class="teaser-liste">
      {pflicht.map((w) => (
        <li><SchemaIcon name={w.icon as IconName} class="teaser-icon" /><span><b>{w.name}</b><small>{w.bestFuer}</small></span></li>
      ))}
    </ul>
  </section>

  <section class="abschnitt reveal unterstuetzen" aria-labelledby="ww-unterstuetzen">
    <SchemaIcon name="funke" class="unterstuetzen-icon" />
    <div>
      <h2 id="ww-unterstuetzen">{t.unterstuetzenTitel}</h2>
      <p>{t.unterstuetzenText}</p>
    </div>
    <Kanaele />
  </section>

  <section class="abschnitt reveal community" aria-labelledby="ww-community">
    <div class="community-innen">
      <p class="eyebrow">{t.communityEyebrow}</p>
      <h2 id="ww-community">{t.mitglied.titel}</h2>
      <p>{t.mitglied.untertitel}</p>
      <Mitglied kompakt />
      <p class="mehr-mitglied"><a href="./mitglied/">{t.mitglied.mehr} <span aria-hidden="true">→</span></a></p>
    </div>
  </section>
</div>

<script>
  // Scroll-Reveal läuft global (Footer.astro). Hier: Cursor-Glow + Magnet-Buttons: nur Maus, nur ohne Bewegungs-Reduzierung
  const fein = matchMedia('(pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (fein) {
    const glow = document.createElement('div');
    glow.className = 'cursor-glow';
    document.body.appendChild(glow);
    let x = 0, y = 0, gx = 0, gy = 0, raf = 0;
    const tick = () => { gx += (x - gx) * 0.18; gy += (y - gy) * 0.18; glow.style.transform = `translate(${gx}px, ${gy}px)`; raf = Math.abs(x - gx) + Math.abs(y - gy) > 0.5 ? requestAnimationFrame(tick) : 0; };
    window.addEventListener('pointermove', (e) => { x = e.clientX; y = e.clientY; glow.classList.add('an'); if (!raf) raf = requestAnimationFrame(tick); }, { passive: true });
    document.addEventListener('pointerleave', () => glow.classList.remove('an'));

    document.querySelectorAll<HTMLElement>('.magnet, .magnet-soft').forEach((el) => {
      const kraft = el.classList.contains('magnet') ? 0.35 : 0.12;
      el.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect();
        const dx = e.clientX - (r.left + r.width / 2), dy = e.clientY - (r.top + r.height / 2);
        el.style.setProperty('--mx', `${dx * kraft}px`); el.style.setProperty('--my', `${dy * kraft}px`);
        el.style.setProperty('--px', `${((e.clientX - r.left) / r.width) * 100}%`); el.style.setProperty('--py', `${((e.clientY - r.top) / r.height) * 100}%`);
      });
      el.addEventListener('pointerleave', () => { el.style.setProperty('--mx', '0px'); el.style.setProperty('--my', '0px'); });
    });
  }
</script>

<style>
  .startseite { position: relative; display: grid; gap: clamp(3.5rem, 8vw, 6.5rem); padding-block: clamp(2.5rem, 6vw, 4.5rem) 2rem; }
  /* Stromlinie: verbindet die Abschnitte, „fließt“ nach unten */
  .stromlinie { position: absolute; inset-block: 0; inset-inline-start: -1.25rem; width: 2px; background: repeating-linear-gradient(to bottom, var(--ww-amber) 0 10px, transparent 10px 22px); opacity: 0.35; mask-image: linear-gradient(to bottom, transparent, #000 8%, #000 92%, transparent); animation: ww-fluss-v 1.4s linear infinite; }
  @keyframes ww-fluss-v { to { background-position: 0 22px; } }
  @media (max-width: 72rem) { .stromlinie { display: none; } }
  @media (prefers-reduced-motion: reduce) { .stromlinie { animation: none; } }
  .abschnitt { position: relative; }
  .abschnitt::before { content: ''; position: absolute; inset-inline-start: -1.6rem; top: 0.4rem; width: 0.8rem; height: 0.8rem; border-radius: 50%; background: var(--ww-amber); box-shadow: 0 0 0 4px color-mix(in srgb, var(--ww-amber) 25%, transparent), 0 0 18px var(--ww-amber); }
  @media (max-width: 72rem) { .abschnitt::before { display: none; } }
  .abschnitt-kopf { margin-bottom: 1.5rem; }
  .eyebrow { margin: 0 0 0.5rem; font-family: var(--__sl-font-mono); font-size: var(--sl-text-xs); letter-spacing: 0.1em; text-transform: uppercase; color: var(--ww-cyan); }
  .abschnitt-kopf h2, .teaser-text h2, .community h2, .unterstuetzen h2 { font-family: var(--ww-font-heading); font-size: clamp(1.9rem, 1.2rem + 2.6vw, 3rem); letter-spacing: -0.035em; line-height: 1.05; margin: 0 0 0.5rem; color: var(--sl-color-white); }
  .abschnitt-kopf p:not(.eyebrow) { margin: 0; color: var(--sl-color-gray-2); max-width: 58ch; line-height: 1.6; font-size: 1.05rem; }
  .folge-kanaele { margin-top: 1rem; }
  ul { list-style: none; margin: 0; padding: 0; }
  .reveal { transition-delay: var(--d, 0ms); }
  .farbe-amber { --farbe: var(--ww-amber); }
  .farbe-orange { --farbe: var(--ww-orange); }
  .farbe-cyan { --farbe: var(--ww-cyan); }

  /* Karten */
  .karten-3 { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); }
  .karte { --farbe: var(--ww-amber); position: relative; display: flex; flex-direction: column; gap: 0.5rem; height: 100%; padding: 1.5rem; border: 1px solid var(--ww-line); border-radius: var(--ww-radius); background: var(--ww-surface); color: inherit; text-decoration: none; overflow: hidden; transform: translate(var(--mx, 0), var(--my, 0)); transition: transform 0.25s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.25s ease, border-color 0.25s ease; }
  .karte::after { content: ''; position: absolute; inset: 0; background: radial-gradient(240px circle at var(--px, 50%) var(--py, 50%), color-mix(in srgb, var(--farbe) 14%, transparent), transparent 60%); opacity: 0; transition: opacity 0.25s ease; pointer-events: none; }
  .karte:hover::after { opacity: 1; }
  .karte:hover, .karte:focus-visible { border-color: var(--farbe); box-shadow: 0 0 0 3px color-mix(in srgb, var(--farbe) 22%, transparent), 0 24px 48px -24px var(--farbe); }
  .karte-icon { width: 3rem; height: 3rem; display: inline-flex; align-items: center; justify-content: center; border-radius: 0.7rem; background: color-mix(in srgb, var(--farbe) 14%, transparent); color: var(--farbe); }
  .karte-titel { font-family: var(--ww-font-heading); font-weight: 700; font-size: 1.3rem; letter-spacing: -0.025em; color: var(--sl-color-white); line-height: 1.2; }
  .karte-text { color: var(--sl-color-gray-2); line-height: 1.55; font-size: var(--sl-text-sm); }
  .karte-cta { margin-top: auto; padding-top: 0.5rem; font-weight: 700; font-size: var(--sl-text-sm); color: var(--farbe); }
  .anleitung { --farbe: var(--ww-cyan); }
  .anleitung-kopf { display: flex; justify-content: space-between; align-items: flex-start; }
  .badge { font-family: var(--__sl-font-mono); font-size: var(--sl-text-2xs); letter-spacing: 0.06em; text-transform: uppercase; padding: 0.25rem 0.6rem; border-radius: 999px; border: 1px solid var(--ww-line); color: var(--sl-color-gray-2); }
  .badge-einstieg { background: var(--ww-grad); border-color: transparent; color: #0f172a; font-weight: 700; }
  .anleitung-fuss { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-top: auto; padding-top: 0.75rem; border-top: 1px dashed var(--ww-line); }
  .anleitung .karte-cta { margin: 0; padding: 0; }
  .lesezeit { font-size: var(--sl-text-xs); color: var(--sl-color-gray-3); font-family: var(--__sl-font-mono); }

  /* Feed: vertikale Video-Karten (9:16) */
  .feed { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(10.5rem, 1fr)); }
  .video { display: flex; flex-direction: column; gap: 0.4rem; color: inherit; text-decoration: none; transform: translate(var(--mx, 0), var(--my, 0)); transition: transform 0.25s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .video-poster { position: relative; aspect-ratio: 9 / 16; border-radius: var(--ww-radius); overflow: hidden; border: 1px solid var(--ww-line); display: flex; align-items: center; justify-content: center;
    background: radial-gradient(70% 60% at 50% 110%, color-mix(in srgb, var(--farbe) 45%, transparent), transparent 70%), linear-gradient(160deg, var(--ww-surface), #0f172a), linear-gradient(var(--ww-grid-line) 1px, transparent 1px), linear-gradient(90deg, var(--ww-grid-line) 1px, transparent 1px); background-size: auto, auto, 1rem 1rem, 1rem 1rem; transition: box-shadow 0.25s ease, border-color 0.25s ease; }
  .video:hover .video-poster { border-color: var(--farbe); box-shadow: 0 0 0 3px color-mix(in srgb, var(--farbe) 25%, transparent), 0 24px 48px -20px var(--farbe); }
  .video .video-poster .video-icon { width: 4.5rem; height: 4.5rem; color: var(--farbe); filter: drop-shadow(0 0 14px color-mix(in srgb, var(--farbe) 70%, transparent)); transition: transform 0.3s ease; }
  .video:hover .video-icon { transform: scale(1.08) rotate(-3deg); }
  .video-play { position: absolute; inset: 0; margin: auto; width: 3rem; height: 3rem; border-radius: 50%; background: rgba(15, 23, 42, 0.75); backdrop-filter: blur(4px); color: #fff; display: flex; align-items: center; justify-content: center; border: 1px solid rgba(255,255,255,0.25); transition: transform 0.25s ease, background 0.25s ease; }
  .video-play svg { width: 1.4rem; height: 1.4rem; }
  .video:hover .video-play { transform: scale(1.12); background: var(--farbe); color: #0f172a; }
  .video-dauer { position: absolute; bottom: 0.5rem; inset-inline-end: 0.5rem; font-family: var(--__sl-font-mono); font-size: var(--sl-text-2xs); padding: 0.1rem 0.4rem; border-radius: 0.3rem; background: rgba(15, 23, 42, 0.8); color: #fff; }
  .video-kanal { position: absolute; top: 0.5rem; inset-inline-start: 0.5rem; display: inline-flex; align-items: center; gap: 0.3rem; font-family: var(--__sl-font-mono); font-size: var(--sl-text-2xs); color: #fff; padding: 0.15rem 0.45rem; border-radius: 999px; background: rgba(15, 23, 42, 0.7); }
  .video-serie { font-family: var(--__sl-font-mono); font-size: var(--sl-text-2xs); letter-spacing: 0.06em; text-transform: uppercase; color: var(--farbe); margin-top: 0.3rem; }
  .video-titel { font-family: var(--ww-font-heading); font-weight: 700; font-size: 1rem; letter-spacing: -0.02em; line-height: 1.2; color: var(--sl-color-white); }
  .video-status { font-size: var(--sl-text-2xs); color: var(--sl-color-gray-3); font-family: var(--__sl-font-mono); }

  /* Themen-Grid */
  .themen-grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); }
  .thema { position: relative; display: flex; flex-direction: column; gap: 0.4rem; height: 100%; padding: 1.4rem; border-radius: var(--ww-radius); color: inherit; text-decoration: none; overflow: hidden; border: 1px solid color-mix(in srgb, var(--farbe) 35%, var(--ww-line)); background: linear-gradient(150deg, color-mix(in srgb, var(--farbe) 18%, var(--ww-surface)), var(--ww-surface) 60%); transform: translate(var(--mx, 0), var(--my, 0)); transition: transform 0.25s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.25s ease; }
  .thema::before { content: ''; position: absolute; top: -40%; inset-inline-end: -20%; width: 60%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, color-mix(in srgb, var(--farbe) 35%, transparent), transparent 65%); pointer-events: none; }
  a.thema:hover, a.thema:focus-visible { box-shadow: 0 0 0 3px color-mix(in srgb, var(--farbe) 25%, transparent), 0 24px 48px -20px var(--farbe); }
  .thema-icon { width: 2.75rem; height: 2.75rem; display: inline-flex; align-items: center; justify-content: center; border-radius: 0.6rem; background: var(--farbe); color: #0f172a; margin-bottom: 0.4rem; box-shadow: 0 8px 20px -8px var(--farbe); }
  .thema-titel { font-family: var(--ww-font-heading); font-weight: 700; font-size: 1.35rem; letter-spacing: -0.03em; color: var(--sl-color-white); line-height: 1.1; }
  .thema-text { font-size: var(--sl-text-sm); color: var(--sl-color-gray-2); line-height: 1.5; }
  .thema-tag { margin-top: auto; padding-top: 0.5rem; font-family: var(--__sl-font-mono); font-size: var(--sl-text-2xs); letter-spacing: 0.06em; text-transform: uppercase; color: var(--sl-color-gray-3); }
  .thema-bald { opacity: 0.75; }
  .mehr { margin: 1rem 0 0; }
  .mehr a { color: var(--ww-amber); font-weight: 700; text-decoration: none; }
  .mehr a:hover { text-decoration: underline; text-underline-offset: 0.2em; }

  /* Buttons */
  .btn { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.85rem 1.4rem; border-radius: 999px; font-weight: 700; text-decoration: none; border: 0; font: inherit; cursor: pointer; transform: translate(var(--mx, 0), var(--my, 0)); transition: transform 0.2s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.2s ease; }
  .btn-primary { background: var(--ww-grad); color: #0f172a; box-shadow: 0 10px 30px -10px var(--ww-orange); }
  .btn-primary:hover { box-shadow: 0 14px 36px -10px var(--ww-orange), 0 0 0 4px color-mix(in srgb, var(--ww-amber) 25%, transparent); }

  /* Werkzeug-Teaser */
  .werkzeug-teaser { display: grid; gap: 2rem; align-items: center; padding: clamp(1.5rem, 4vw, 2.5rem); border-radius: calc(var(--ww-radius) * 1.5); border: 1px solid var(--ww-line); background: linear-gradient(135deg, color-mix(in srgb, var(--ww-amber) 12%, var(--ww-surface)), var(--ww-surface) 55%, color-mix(in srgb, var(--ww-cyan) 10%, var(--ww-surface))); }
  @media (min-width: 50rem) { .werkzeug-teaser { grid-template-columns: 1.2fr 1fr; } }
  .teaser-text p:not(.eyebrow) { color: var(--sl-color-gray-2); line-height: 1.6; margin: 0 0 1.25rem; }
  .teaser-liste { display: grid; gap: 0.6rem; }
  .teaser-liste li { display: flex; gap: 0.9rem; align-items: center; padding: 0.8rem 1rem; border-radius: var(--ww-radius-sm); background: rgba(15, 23, 42, 0.35); border: 1px solid var(--ww-line); }
  .teaser-icon { color: var(--ww-amber); }
