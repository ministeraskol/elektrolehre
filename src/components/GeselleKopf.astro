---
// Watt, Geselle – Kopf als runde Plakette. Büste aus Kadirs Sticker-Referenz (src/assets/geselle), Marken-Amber als Grund.
import { Image } from 'astro:assets';
import kopf from '../assets/geselle/geselle-watt-kopf.png';
interface Props { size?: number; class?: string }
const { size = 36, class: className } = Astro.props;
---
<span class:list={['ww-watt', className]} style={`width:${size}px;height:${size}px`} aria-hidden="true">
  <Image src={kopf} alt="" width={Math.round(size * 1.25)} densities={[1, 2, 3]} loading="eager" />
</span>
<style>
  .ww-watt { display: inline-block; flex: none; overflow: hidden; border-radius: 50%; background: #f5b23c; box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.14); vertical-align: middle; }
  .ww-watt :global(img) { display: block; box-sizing: border-box; width: 100%; height: 100%; margin: 0; padding-top: 7%; object-fit: cover; object-position: 50% 0; }
</style>
