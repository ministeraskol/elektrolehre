# Cloudflare Pages: Sicherheits-Header (von GitHub Pages ignoriert). Stand 12. Sep 2026.
# CSP: Astro/Starlight liefern Inline-Skripte und -Styles → 'unsafe-inline' nötig; keine externen Skripte. Pagefind (Suche) lädt WebAssembly → 'wasm-unsafe-eval'.
# Bilder: nur eigene, selbst gehostet (keine externen Bildquellen). Formulare: eigene Seite + Brevo (Mitgliedschaft), sobald aktiv.
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self' https://*.brevo.com https://*.sendinblue.com; upgrade-insecure-requests
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  X-Robots-Tag: noai, noimageai

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/pagefind/*
  Cache-Control: public, max-age=86400

# Cloudflare-Hosts nicht indexieren: wattwas.pages.dev und Vorschau-/Branch-Deployments (<hash|branch>.wattwas.pages.dev).
# Header aus mehreren passenden Regeln verbindet Cloudflare mit Komma → dort X-Robots-Tag: noai, noimageai, noindex.
https://wattwas.pages.dev/*
  X-Robots-Tag: noindex

https://:version.wattwas.pages.dev/*
  X-Robots-Tag: noindex
